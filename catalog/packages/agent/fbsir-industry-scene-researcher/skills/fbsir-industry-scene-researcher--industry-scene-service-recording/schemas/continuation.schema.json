{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaochuang.example/schemas/continuation.schema.json",
  "title": "Bounded continuation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "currentQuestion",
    "confirmedChoices",
    "sourceChanges",
    "completed",
    "openItems",
    "invalidatedReviews",
    "nextAction",
    "sources",
    "observationStates",
    "reviews",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "research.continuation/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "currentQuestion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "confirmedChoices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "audience": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "primaryDeliverable": {
      "enum": ["case_comparison", "case_analysis", "tool_comparison", "action_method", "communication", null]
    },
    "sourceChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invalidatedReviews": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "nextAction": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceFingerprint"
      }
    },
    "observationStates": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/processingState"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/review"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/section"
      }
    }
  }
}
