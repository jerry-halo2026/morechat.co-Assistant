{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaochuang.example/schemas/material-observation.schema.json",
  "title": "Material observation; declared observations do not prove real media processing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceId",
    "sourceIdentity",
    "sourceVersion",
    "materialRole",
    "modality",
    "observationKind",
    "processor",
    "anchors",
    "coverage",
    "content",
    "status",
    "derivedFromObservationIds",
    "limitations",
    "semantics",
    "cacheComponents",
    "cacheKey"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sourceIdentity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "materialRole": {
      "$ref": "common.schema.json#/$defs/sourceRole"
    },
    "modality": {
      "$ref": "common.schema.json#/$defs/modality"
    },
    "observationKind": {
      "$ref": "common.schema.json#/$defs/observationKind"
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "page1Based",
          "region",
          "dimensions",
          "rectangle",
          "sheet",
          "cellRange",
          "start",
          "end",
          "timebase",
          "speakerLabelProvenance"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "page1Based": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "dimensions": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "width",
                  "height"
                ],
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "rectangle": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "sheet": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cellRange": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "start": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "timebase": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "speakerLabelProvenance": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "frameTimestamp": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "frameIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "transformReference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "coordinateSpace": {
            "enum": [
              "source_pixels",
              "normalized",
              "not_applicable"
            ]
          }
        }
      }
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "ambiguous",
        "conflicted",
        "unsupported",
        "not_observed",
        "failed",
        "invalidated"
      ]
    },
    "derivedFromObservationIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polarity",
        "temporalMode",
        "exactText",
        "qualifiers",
        "units",
        "period",
        "uncertainties"
      ],
      "properties": {
        "polarity": {
          "enum": [
            "affirmative",
            "negative",
            "mixed",
            "unknown"
          ]
        },
        "temporalMode": {
          "enum": [
            "historical_result",
            "current_state",
            "plan",
            "target",
            "budget",
            "forecast",
            "hypothesis",
            "unknown"
          ]
        },
        "exactText": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cacheComponents": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/cacheComponents"
        },
        {
          "type": "null"
        }
      ]
    },
    "cacheKey": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "tabularContext": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headers",
            "unit",
            "currency",
            "period",
            "filters",
            "footnotes",
            "cells"
          ],
          "properties": {
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "period": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "footnotes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "address",
                  "formula",
                  "displayValue",
                  "cachedValue",
                  "calculatedValue",
                  "calculationState",
                  "calculationEvidenceRef"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "formula": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "displayValue": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "cachedValue": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "calculatedValue": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "calculationState": {
                    "enum": [
                      "not_calculated",
                      "supplied",
                      "calculated"
                    ]
                  },
                  "calculationEvidenceRef": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
