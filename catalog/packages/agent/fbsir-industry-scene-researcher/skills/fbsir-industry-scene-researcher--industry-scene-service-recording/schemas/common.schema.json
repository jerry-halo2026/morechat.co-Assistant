{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaochuang.example/schemas/common.schema.json",
  "title": "Research kernel shared contracts",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidenceStatus": {
      "enum": [
        "source_fact",
        "company_claim",
        "independent_observation",
        "user_statement",
        "inference",
        "hypothesis",
        "unknown"
      ]
    },
    "sourceRole": {
      "enum": [
        "fact_evidence",
        "user_statement",
        "reference_style",
        "reference_layout",
        "background_context",
        "research_lead",
        "synthetic_example"
      ]
    },
    "modality": {
      "enum": [
        "text_document",
        "pdf_scan",
        "image",
        "spreadsheet",
        "slides_web",
        "audio",
        "video"
      ]
    },
    "observationKind": {
      "enum": [
        "native_visual_observation",
        "native_audio_observation",
        "text_extraction",
        "table_extraction",
        "ocr_derivative",
        "asr_derivative",
        "user_supplied_transcript",
        "user_supplied_observation",
        "metadata_only",
        "synthetic_observation_fixture"
      ]
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "representation",
        "knownTotal",
        "totalBasis",
        "requestedRanges",
        "observedRanges",
        "scopeMode",
        "granularity",
        "timebase",
        "state",
        "completeClaim"
      ],
      "properties": {
        "unit": {
          "enum": [
            "bytes",
            "characters",
            "paragraphs",
            "pages",
            "regions",
            "cells",
            "rows",
            "slides",
            "images",
            "seconds",
            "frames",
            "items"
          ]
        },
        "representation": {
          "enum": [
            "text",
            "visual",
            "audio",
            "table",
            "metadata"
          ]
        },
        "knownTotal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "totalBasis": {
          "enum": [
            "observed_metadata",
            "user_declared",
            "synthetic_fixture",
            "unknown"
          ]
        },
        "requestedRanges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "observedRanges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "scopeMode": {
          "enum": [
            "whole_source",
            "selected_scope"
          ]
        },
        "granularity": {
          "enum": [
            "whole_unit",
            "partial_unit",
            "point_sample"
          ]
        },
        "timebase": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "state": {
          "enum": [
            "not_observed",
            "metadata_only",
            "sampled",
            "partial",
            "complete_for_declared_scope",
            "failed",
            "not_applicable"
          ]
        },
        "completeClaim": {
          "type": "boolean"
        }
      }
    },
    "cacheComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceContentDigest",
        "sourceVersion",
        "sourceIdentityBasis",
        "processorId",
        "processorVersion",
        "processingParameters",
        "anchorRange",
        "materialRole",
        "purpose",
        "representationGeneration"
      ],
      "properties": {
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sourceContentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceIdentityBasis": {
          "enum": [
            "observed_bytes",
            "synthetic_fixture"
          ]
        },
        "processorId": {
          "type": "string",
          "minLength": 1
        },
        "processorVersion": {
          "type": "string",
          "minLength": 1
        },
        "processingParameters": {
          "$ref": "common.schema.json#/$defs/jsonObject"
        },
        "anchorRange": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "representation", "timebase", "ranges", "anchors"],
              "properties": {
                "unit": {"$ref": "#/$defs/coverage/properties/unit"},
                "representation": {"$ref": "#/$defs/coverage/properties/representation"},
                "timebase": {"type": ["string", "null"], "minLength": 1},
                "ranges": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "anchors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            },
            {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonValue"}},
            {"type": "string", "minLength": 1}
          ]
        },
        "materialRole": {
          "enum": [
            "fact_evidence",
            "user_statement",
            "reference_style",
            "reference_layout",
            "background_context",
            "research_lead",
            "synthetic_example"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "representationGeneration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentDigest",
        "version",
        "identityBasis"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "contentDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "identityBasis": {
          "enum": [
            "observed_bytes",
            "provided_digest",
            "synthetic_fixture",
            "unknown"
          ]
        },
        "derivedFrom": {
          "anyOf": [
            {"$ref": "common.schema.json#/$defs/id"},
            {"type": "null"}
          ]
        }
      }
    },
    "batchPlanningInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "sourceVersion", "purpose", "knownTotal", "unit", "maxUnitsPerBatch", "contentUnits"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "sourceVersion": {"type": ["string", "null"], "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "knownTotal": {"type": ["number", "null"], "minimum": 0},
        "unit": {"$ref": "#/$defs/coverage/properties/unit"},
        "maxUnitsPerBatch": {"type": "integer", "minimum": 1, "maximum": 100},
        "contentUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "locator", "range", "state", "observationIds", "unknowns", "readReceiptRef", "contentSha256"],
            "allOf": [{"if": {"properties": {"state": {"const": "available"}}, "required": ["state"]}, "then": {"required": ["readReceiptRef", "contentSha256"]}}],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "locator": {"type": "string", "minLength": 1},
              "range": {
                "type": ["array", "null"],
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "state": {"enum": ["available", "failed", "partial", "metadata_only", "not_observed"]},
              "observationIds": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
              "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "readReceiptRef": {"type": ["string", "null"], "minLength": 1},
              "contentSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "locator",
        "observationId",
        "exactQuote"
      ],
      "properties": {
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observationId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "exactQuote": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "denominator",
        "baseline",
        "comparisonPeriod",
        "method",
        "currency"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ]
        },
        "comparisonPeriod": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "analysisItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "kind",
        "claimIds",
        "caseIds"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inference",
            "hypothesis",
            "unknown"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "caseIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "decisionOrWork",
        "audience",
        "constraints",
        "primaryDeliverable",
        "additionalDeliverables",
        "readingScope",
        "researchMode",
        "searchTerms",
        "geography",
        "timeRange",
        "requestedCount",
        "sourcePolicy",
        "formats",
        "unknowns"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "question": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "decisionOrWork": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audience": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primaryDeliverable": {
          "enum": [
            "case_comparison",
            "case_analysis",
            "tool_comparison",
            "action_method",
            "communication"
          ]
        },
        "additionalDeliverables": {
          "type": "array",
          "items": {
            "enum": [
              "case_comparison",
              "case_analysis",
              "tool_comparison",
              "action_method",
              "communication"
            ]
          },
          "uniqueItems": true
        },
        "readingScope": {
          "enum": [
            "complete",
            "sampled",
            "question_directed",
            "not_applicable"
          ]
        },
        "researchMode": {
          "enum": [
            "live_search",
            "materials_only"
          ]
        },
        "searchTerms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "industry",
            "workflow",
            "mechanism",
            "conditions"
          ],
          "properties": {
            "industry": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workflow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mechanism": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "geography": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeRange": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "requestedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "sourcePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "domains"
          ],
          "properties": {
            "mode": {
              "enum": [
                "unrestricted",
                "prefer",
                "only"
              ]
            },
            "domains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "userMaterialSourceIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "common.schema.json#/$defs/id"}
            }
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "markdown",
              "csv",
              "html",
              "docx",
              "xlsx",
              "pptx",
              "pdf",
              "other"
            ]
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pathOrChat",
        "format",
        "status",
        "sourceIds",
        "claimIds",
        "caseIds",
        "checks",
        "events",
        "unmetRequirements"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "pathOrChat": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "format": {
          "enum": [
            "markdown",
            "csv",
            "html",
            "docx",
            "xlsx",
            "pptx",
            "pdf",
            "png",
            "audio",
            "video",
            "other"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "created",
            "read_back",
            "presented",
            "accepted",
            "partial",
            "blocked",
            "stale"
          ]
        },
        "deliveryMode": {
          "enum": ["chat", "file"]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "caseIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "details"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run"
                ]
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "evidenceRef",
              "at",
              "actorType"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "created",
                  "read_back",
                  "presented",
                  "accepted"
                ]
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "actorType": {
                "enum": [
                  "tool",
                  "model",
                  "user",
                  "external"
                ]
              },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": ["toolName", "artifactId", "contentSha256", "hostSurface", "sessionId", "observedAt"],
                "properties": {
                  "toolName": {"type": "string", "minLength": 1},
                  "artifactId": {"type": "string", "minLength": 1},
                  "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "hostSurface": {"type": "string", "minLength": 1},
                  "sessionId": {"type": "string", "minLength": 1},
                  "operationId": {"type": ["string", "null"], "minLength": 1},
                  "observedAt": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        },
        "unmetRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "author",
        "locked",
        "sourceIds",
        "observationIds",
        "needsReview"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "content": {
          "type": "string"
        },
        "author": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "observationIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "needsReview": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observationIds",
        "status",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "observationIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "pending",
            "valid",
            "invalidated"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "processingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "cacheComponents",
        "cacheKey",
        "status",
        "claimIds",
        "invalidationReasons"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "cacheComponents": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/cacheComponents"
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheKey": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "observed",
            "ambiguous",
            "conflicted",
            "failed",
            "unknown",
            "invalidated"
          ]
        },
        "claimIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "invalidationReasons": {
          "type": "array",
          "items": {
